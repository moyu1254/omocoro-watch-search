      "duration": 2.821,
      "text": "バレてました。"
    },
    {
      "start": 575.399,
      "duration": 3.682,
      "text": "すいませんかい。"
    },
    {
      "start": 577.061,
      "duration": 2.02,
      "text": "[笑い]"
    },
    {
      "start": 579.24,
      "duration": 3.0,
      "text": "今のはそうでしたね。そう"
    },
    {
      "start": 584.68,
      "duration": 2.261,
      "text": "れてました。[笑い]"
    },
    {
      "start": 587.24,
      "duration": 4.286,
      "text": "本元のかなと思ったらマをじしてくるぞと思ったら急に呼ばれた"
    },
    {
      "start": 589.506,
      "duration": 2.02,
      "text": "[笑い]"
    },
    {
      "start": 594.091,
      "duration": 2.188,
      "text": "[笑い]"
    },
    {
      "start": 595.32,
      "duration": 3.32,
      "text": "準備がね。"
    },
    {
      "start": 596.279,
      "duration": 3.321,
      "text": "全くなんで呼ばれたの?うん。"
    },
    {
      "start": 598.64,
      "duration": 1.759,
      "text": "すいません。"
    },
    {
      "start": 599.6,
      "duration": 1.76,
      "text": "すいません。"
    },
    {
      "start": 600.399,
