      "start": 647.32,
      "duration": 5.0,
      "text": "言ってない。何も言ってない。"
    },
    {
      "start": 649.32,
      "duration": 3.0,
      "text": "かトさん最近ひどくてす"
    },
    {
      "start": 652.72,
      "duration": 2.997,
      "text": "ちっぽちっぽって言ってまし。[笑い]"
